# ── Python bytecode / caches（部署不需要，运行时自动生成）──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── 虚拟环境 ──
.venv/
venv/
env/

# ── 构建产物 ──
build/
dist/
*.egg-info/
.eggs/

# ── 密钥 / 本地配置（绝不入库、绝不进镜像）──
.env
.env.local
*.env

# ── 测试 / 工具缓存 ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
_tmp_*.py

# ── IDE / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
