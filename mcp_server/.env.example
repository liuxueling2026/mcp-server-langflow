# ─────────────────────────────────────────────
# Neo4j connection (required for neo4j_query tool)
# ─────────────────────────────────────────────
# Neo4j Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
# Local Neo4j: bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# ─────────────────────────────────────────────
# MCP Server (HTTP transport)
# ─────────────────────────────────────────────
# When deploying to the cloud, bind to 0.0.0.0 so the container is reachable.
MCP_HOST=0.0.0.0
MCP_PORT=$PORT

# ─────────────────────────────────────────────
# PostgreSQL / PGVector (required for pgvector tools)
# SQLAlchemy-style, e.g. postgresql+psycopg2://user:pass@host:5432/dbname
# ─────────────────────────────────────────────
PG_CONNECTION_STRING=postgresql+psycopg2://postgres:your-password@localhost:5432/postgres

# ─────────────────────────────────────────────
# Embedding provider (pluggable; switch model by editing only these)
#   EMBEDDING_PROVIDER: ollama | openai | watsonx
# ─────────────────────────────────────────────
#EMBEDDING_PROVIDER=ollama
#EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_USE_TASK_PREFIX=false

# ── IBM watsonx.ai (only when EMBEDDING_PROVIDER=watsonx) ──
# watsonx is NOT OpenAI-compatible: it uses IBM Cloud IAM + a project_id.
# To use it, set the following (note EMBEDDING_MODEL must be a watsonx model_id):
#   EMBEDDING_PROVIDER=watsonx
#   EMBEDDING_MODEL=ibm/granite-embedding-278m-multilingual
# then fill the values below:
EMBEDDING_PROVIDER=watsonx
EMBEDDING_MODEL=ibm/granite-embedding-278m-multilingual
WATSONX_URL=https://jp-tok.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# WATSONX_SPACE_ID=                  # alternative to project_id (set only one)



