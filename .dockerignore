# Keep the build context (and final image) clean for cloud deployment.

# Python bytecode / caches — regenerated at runtime, never ship them
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Secrets / local config — must NOT be baked into the image
.env
.env.local
*.env

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Tooling / test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
_tmp_*.py

# VCS / IDE / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
